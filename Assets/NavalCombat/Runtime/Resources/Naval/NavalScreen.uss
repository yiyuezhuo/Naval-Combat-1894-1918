/* Application layout. Native controls are styled by the default Unity theme. */
.unity-ui-document__root { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.naval-root { flex-grow: 1; min-height: 0; font-size: 16px; }
.hidden { display: none; }
.grow { flex-grow: 1; min-height: 0; }
.columns { flex-direction: row; flex-grow: 1; min-height: 0; }
.page, .battle { flex-grow: 1; flex-basis: 0; min-height: 0; }
.page { padding: 28px; background-color: #eef0f2; }
.panel { padding: 10px; }
.toolbar { flex-direction: row; flex-wrap: wrap; align-items: center; padding: 7px; flex-shrink: 0; }
.title { font-size: 27px; margin-bottom: 14px; white-space: normal; flex-shrink: 0; }
.subtitle { font-size: 17px; margin-bottom: 18px; white-space: normal; flex-shrink: 0; }
#archiveCredit { margin-left: 8px; flex-shrink: 0; white-space: nowrap; }
#quitGame { margin-left: auto; flex-shrink: 0; }
.prose { white-space: normal; margin-bottom: 12px; flex-shrink: 0; }
.section-title { margin-top: 12px; margin-bottom: 10px; -unity-font-style: bold; white-space: normal; flex-shrink: 0; }
.validation-error { color: #a12525; white-space: normal; }
Button.primary { -unity-font-style: bold; }
.scenario-list { width: 44%; margin-top: 14px; margin-right: 28px; }
.scenario-row { margin: 0; padding: 2px 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-left; }
.preview { flex-grow: 1; flex-basis: 0; margin-top: 14px; }
.status { min-height: 18px; font-size: 11px; padding: 1px 12px; white-space: normal; flex-shrink: 0; background-color: #eef0f2; }

/* Header and optional fleet sidebar. */
.masthead { flex-direction: row; flex-shrink: 0; min-height: 42px; align-items: flex-start; padding: 3px 8px; }
#hudActions Button, #hudTimePanel Button { flex-grow: 0; flex-shrink: 0; min-height: 26px; padding: 3px 6px; margin: 2px; font-size: 12px; white-space: nowrap; }
#clock { flex-grow: 0; flex-shrink: 0; height: 24px; font-size: 13px; margin: 2px; white-space: nowrap; -unity-text-align: middle-left; }
#hudLeftToolbar { flex-direction: column; flex-grow: 1; flex-basis: 0; min-width: 0; margin-right: 8px; }
.hud-actions { flex-direction: row; flex-wrap: wrap; align-items: center; align-content: flex-start; justify-content: flex-start; flex-shrink: 0; min-width: 0; }
#hudToolbarSurface { flex-direction: column; flex-shrink: 0; min-width: 0; background-color: rgba(238,240,242,.82); }
#hudLeftToolbar > .view-hint { align-self: flex-start; max-width: 100%; flex-shrink: 0; margin: 0; }
#hudToolbarSurface, #hudTimePanel { border-radius: 4px; }
#hudTimePanel { flex-direction: row; align-items: flex-start; width: 350px; min-width: 350px; max-width: 350px; flex-shrink: 0; background-color: rgba(238,240,242,.82); }
#hudTimeControls { flex-grow: 1; flex-basis: 0; min-width: 0; }
#hudSpeedControls { flex-direction: row; flex-wrap: nowrap; }
#hudTimePanel #menu { margin-left: 4px; }
#hudSpeedControls Button { width: 38px; min-width: 38px; max-width: 38px; padding-left: 2px; padding-right: 2px; border-width: 2px; }
#hudSpeedControls Button.speed-selected { background-color: #66501c; color: #fff4ba; border-left-color: #9d751d; border-top-color: #9d751d; border-right-color: #ffe09a; border-bottom-color: #ffe09a; -unity-font-style: bold; }
.fleet-switch { flex-direction: row; align-items: center; flex-shrink: 0; margin: 2px 5px; font-size: 12px; }
.fleet-switch > Label { margin-right: 4px; }
.fleet-switch > Toggle { margin: 0; flex-grow: 0; flex-shrink: 0; }
.battle-hud #status { display: none; }
.archive-screen .masthead, .archive-screen #status, .briefing-screen .masthead, .briefing-screen #status { display: none; }
#hudActions { display: none; }
.battle-hud #hudActions { display: flex; }
#battle > .toolbar { display: none; }
#bridgeControls { display: flex; padding: 2px 0; }
#bridgeControls Button { flex-shrink: 0; min-height: 26px; padding: 3px 6px; margin: 2px; font-size: 12px; white-space: nowrap; }
.bridge-height { flex-direction: row; align-items: center; flex-shrink: 0; margin-left: 8px; }
.bridge-height > Label { margin-right: 4px; font-size: 12px; }
#bridgeHeight { width: 70px; height: 26px; min-height: 0; margin: 0; padding: 0; font-size: 12px; }
#bridgeHeight .unity-base-field__input { min-height: 0; padding: 1px 4px; }
#bridgeControls .fleet-switch > Label, .bridge-height > Label { margin-top: 0; margin-bottom: 0; padding-top: 0; padding-bottom: 0; }
#bridgeControls.hidden { display: none; }
.oob { position: absolute; left: 0; bottom: 0; height: 50%; width: 260px; padding: 6px; background-color: #eef0f2; }
.fleet-row { flex-direction: row; align-items: center; flex-grow: 1; }
.fleet-name { flex-grow: 1; flex-basis: 0; white-space: nowrap; }
.fleet-speed { width: 60px; font-size: 12px; -unity-text-align: middle-right; }

/* Camera viewport and world-space label overlays. */
.battle-center { flex-grow: 1; flex-basis: 0; min-width: 0; }
.viewport { flex-grow: 1; min-width: 0; min-height: 100px; }
.view-hint { background-color: rgba(18,30,39,.85); color: #ffffff; font-size: 11px; padding: 3px 6px; white-space: normal; }
.ship-label { position: absolute; left: 0; top: 0; color: #f0d3c1; background-color: rgba(17,29,38,.75); font-size: 12px; padding: 2px 4px; max-width: 150px; }
.ship-label.friendly { color: #c7e5e9; }

/* Translucent ship HUD. Only content spacing is customized, not native control chrome. */
.inspector-column { position: absolute; right: 8px; top: 8px; bottom: 8px; width: 350px; align-items: stretch; }
#inspector { flex-grow: 1; flex-basis: 0; flex-shrink: 1; min-height: 0; padding: 0; font-size: 14px; }
.hud-section { flex-shrink: 0; margin: 0 0 5px 0; padding: 4px 8px; background-color: rgba(242,246,247,.86); border-radius: 4px; }
.hud-section > .unity-foldout__toggle { margin: 0; min-height: 22px; -unity-font-style: bold; font-size: 14px; }
.hud-section > .unity-foldout__content { margin-left: 0; }
.hud-section .prose { margin-bottom: 5px; }
.hud-section .status-row, .hud-section .weapon-row { font-size: 12px; }
#shipStats { font-size: 13px; margin-bottom: 4px; }
#dossier, #shipTactical, #spacing, #logs { display: none; }
.maneuver-row { flex-direction: row; align-items: center; }
.maneuver-row > .unity-slider { flex-grow: 1; flex-basis: 0; min-width: 0; }
.maneuver-row > .unity-float-field { width: 75px; }
.maneuver-row .unity-base-field__label { min-width: 55px; }
#currentManeuver { font-size: 11px; margin-bottom: 5px; }
#damageTable { padding: 3px 0; }
.status-row, .weapon-row { flex-direction: row; justify-content: space-between; padding: 2px 0; flex-shrink: 0; }
.status-key { flex-shrink: 1; white-space: normal; margin-right: 8px; }
.status-value { flex-grow: 1; flex-basis: 0; white-space: normal; -unity-text-align: upper-right; }
.weapon-row { margin-top: 6px; padding-top: 5px; }
#damageAlerts { font-size: 11px; margin-bottom: 2px; padding-top: 3px; border-top-width: 1px; border-top-color: rgba(65,75,80,.3); }
.armament-compact { white-space: normal; font-size: 12px; margin-top: 4px; }
#damageBar { height: 14px; margin: 2px 0; }
#damageBar .unity-progress-bar__title { font-size: 11px; }
#previewMode { align-self: flex-end; width: 130px; flex-shrink: 0; margin: 3px 0; }
.preview-square { position: relative; align-self: flex-end; flex-shrink: 0; overflow: hidden; background-color: rgba(250,252,252,.9); }
#vesselPlan { position: absolute; flex-shrink: 0; margin: 0; }

/* Compact log and report content. */
.combat-log { position: absolute; left: 268px; bottom: 8px; right: 370px; height: 120px; padding: 5px 8px 25px 8px; background-color: rgba(235,242,245,.76); border-radius: 4px; }
.combat-log > .section-title { display: none; }
.hud-log-line { font-size: 11px; white-space: normal; margin: 0; padding: 0; color: #24343c; flex-shrink: 0; }
#logDetails { position: absolute; right: 4px; bottom: 2px; font-size: 11px; min-height: 20px; padding: 1px 6px; }
.log-detail-line { white-space: normal; font-size: 14px; margin: 0; padding: 2px 4px; flex-shrink: 0; }
#victoryReport { flex-grow: 1; flex-basis: 0; min-height: 0; }
.victory-card { padding: 12px; margin-bottom: 12px; flex-shrink: 0; }
.victory-card > Label, .victory-card > MultiColumnListView { flex-shrink: 0; }
.victory-ship { padding: 6px; flex-shrink: 0; }
.victory-damage { height: 12px; flex-direction: row; background-color: #e1e5e7; }
.victory-damage > VisualElement { height: 12px; }

/* Modal sizing, contextual menus and document layouts. */
.modal { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(0,0,0,.7); }
.dialog { padding: 20px; max-width: 94%; max-height: 90%; background-color: #eef0f2; }
#modalBody { flex-basis: 0; min-height: 0; }
#modalActions { flex-shrink: 0; }
.menu-body { max-width: 560px; align-self: center; width: 100%; }
.dialog-compact { width: 520px; height: auto; }
.dialog-compact #modalBody { flex-grow: 0; flex-basis: auto; }
.dialog-compact .menu-body { width: auto; align-self: stretch; }
.dialog-compact .title { font-size: 22px; margin-bottom: 10px; }
.dialog-compact .unity-scroll-view { max-height: 430px; }
.dialog-medium { width: 760px; height: 76%; }
.dialog-large { width: 88%; height: 88%; }
.tactical-context { position: absolute; left: 0; top: 0; min-width: 230px; max-width: 420px; padding: 5px; background-color: #eef0f2; }
.context-item { margin: 0; -unity-text-align: middle-left; }
.analysis-targets { width: 45%; margin-right: 14px; }
.analysis-details { flex-grow: 1; flex-basis: 0; min-width: 0; }
.torpedo-diagram { flex-grow: 1; min-height: 240px; background-color: #f5f5f2; overflow: hidden; }
.dossier-plan { height: 250px; flex-shrink: 0; }
.weapon-diagram { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; background-color: white; margin-bottom: 12px; padding: 8px; }
.weapon-sectors { flex-grow: 1; flex-basis: 340px; min-width: 310px; height: 330px; }
.weapon-penetration { flex-grow: 2; flex-basis: 490px; min-width: 360px; height: 330px; }
.dossier-content { padding: 0 6px; }
.dossier-eyebrow { font-size: 12px; white-space: normal; flex-shrink: 0; margin: 0; }
.dossier-subtitle { font-size: 16px; margin: 4px 0; white-space: normal; flex-shrink: 0; }
.dossier-section-heading { flex-direction: row; align-items: center; margin: 18px 0 10px 0; flex-shrink: 0; }
.dossier-rule { flex-grow: 1; height: 1px; background-color: #777777; margin-left: 14px; }
.dossier-record { flex-shrink: 0; padding: 8px; border-bottom-width: 1px; border-bottom-color: #c5c5c5; }
.dossier-record-line { flex-direction: row; flex-wrap: wrap; align-items: flex-start; }
.dossier-record-name { width: 210px; flex-shrink: 0; -unity-font-style: bold; white-space: normal; margin: 0 8px 0 0; }
.dossier-record-summary { flex-grow: 1; flex-basis: 180px; white-space: normal; margin: 0; }
.dossier-record-detail { font-size: 12px; color: #444444; white-space: normal; margin: 5px 0 0 0; }
.dossier-inline-link { flex-shrink: 0; margin: 0 0 0 12px; padding: 0 0 2px 0; background-color: transparent; border-width: 0; border-bottom-width: 1px; border-bottom-color: #222222; border-radius: 0; -unity-font-style: bold; }
.dossier-inline-link:hover { background-color: #e0e5e9; }
.dossier-body .dossier-facts { justify-content: space-between; }
.dossier-body .dossier-fact { width: auto; flex-basis: 49%; flex-grow: 0; min-width: 280px; border-bottom-width: 1px; border-bottom-color: #c5c5c5; }
.dossier-body .fact-label, .dossier-body .fact-value { margin: 0; }

.history-card { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; padding: 6px; margin-bottom: 8px; border-width: 1px; border-color: #222222; }
.history-pie { width: 220px; min-width: 220px; height: 220px; flex-grow: 0; flex-shrink: 0; margin-right: 8px; }
.history-bars { flex-grow: 1; flex-basis: 560px; min-width: 420px; height: 260px; margin-right: 8px; }
.history-legend { flex-grow: 1; flex-basis: 220px; min-width: 120px; }
.history-bar-legend { flex-grow: 0; flex-shrink: 1; flex-basis: 180px; max-width: 180px; }
.history-legend-row { flex-direction: row; align-items: flex-start; margin-bottom: 3px; }
.history-swatch { width: 12px; height: 12px; flex-shrink: 0; margin-right: 6px; margin-top: 4px; border-width: 1px; border-color: black; }
.dossier-log { height: 350px; flex-shrink: 0; }
.dossier-facts { flex-direction: row; flex-wrap: wrap; }
.dossier-fact { width: 50%; flex-direction: row; padding: 8px; }
.fact-label { width: 45%; white-space: normal; }
.fact-value { flex-grow: 1; flex-basis: 0; white-space: normal; }
.armor-row { flex-direction: row; padding: 8px; }
.armor-value { width: 105px; -unity-text-align: middle-right; }
.armor-table { height: 230px; flex-shrink: 0; }
.fault-details { flex-grow: 1; align-items: stretch; }
.fault-details > .unity-base-field__input { white-space: normal; }

/* Allow scrollable native controls to fit bounded flex containers.
   No global input/slider dimensions: they also affect scrollbar internals. */
.unity-scroll-view { min-height: 0; }
.unity-tab-view { flex-grow: 1; min-height: 0; }
.unity-tab-view__content-container, .unity-tab, .unity-tab__content-container { flex-grow: 1; flex-basis: 0; min-height: 0; }
.unity-collection-view__scroll-view { flex-grow: 1; flex-basis: 0; min-height: 0; }
.unity-multi-column-view__cell Label, .unity-multi-column-header__column__title { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.touch-input .context-item { min-height: 40px; padding: 6px 12px; }
#touchActions { position: absolute; left: 0; bottom: 60px; height: 50%; width: 260px; max-width: 48%; padding: 6px; background-color: rgba(235,242,245,.94); display: none; }
#touchToggle { position: absolute; left: 0; bottom: 4px; width: 260px; min-width: 260px; max-width: none; display: none; }
.touch-action { min-height: 48px; flex-shrink: 0; font-size: 18px; white-space: normal; padding: 8px 12px; margin: 3px 0; }
.touch-choices .touch-action { min-height: 56px; }
.touch-input .oob { bottom: 60px; }
.touch-input #modalActions Button { min-height: 44px; font-size: 18px; padding: 6px 14px; }
#helpMarkdown { flex-shrink: 0; font-size: 17px; }
.battle-help .markdown-list-item { margin-bottom: 8px; }
.battle-help .markdown-list-content .markdown-paragraph { margin-top: 0; margin-bottom: 0; }
.battle-help .markdown-list-bullet-marker { height: 24px; }

/* Dense selected-vessel readout; keep native foldout and input controls. */
.hud-section Label { margin-top: 0; margin-bottom: 0; padding-top: 0; padding-bottom: 0; }
.hud-section .unity-foldout__content { padding: 0; }
.hud-section .status-row, .hud-section .weapon-row { min-height: 17px; padding: 0; }
.hud-section .weapon-row { margin-top: 4px; padding-top: 3px; border-top-width: 1px; border-top-color: rgba(65,75,80,.3); }
.hud-section .status-key, .hud-section .status-value { margin-left: 0; margin-right: 0; padding-left: 0; padding-right: 0; }
.hud-section .status-key { margin-right: 5px; }
.maneuver-row .unity-base-field { height: 25px; min-height: 0; margin-top: 1px; margin-bottom: 1px; font-size: 12px; }
.maneuver-row .unity-base-field__input { min-height: 0; padding-top: 1px; padding-bottom: 1px; }
#damageHeader { height: 22px; flex-shrink: 0; margin-bottom: 3px; }
#damageHeader #damageBar { height: 18px; min-height: 0; flex-shrink: 0; margin: 2px 0; }
#damageBar .unity-progress-bar__container, #damageBar .unity-progress-bar__background, #damageBar .unity-progress-bar__progress { min-height: 0; height: 18px; margin-top: 0; margin-bottom: 0; padding-top: 0; padding-bottom: 0; }
#previewMode { position: absolute; right: 3px; width: 110px; height: 22px; min-height: 0; margin: 0; font-size: 11px; }
#previewMode .unity-base-field__input { min-height: 0; padding: 1px 3px; }
#mapCompass { position: absolute; left: 12px; top: 30px; width: 64px; height: 64px; align-items: center; justify-content: center; }
#mapNorth { width: 44px; height: 28px; margin: 0; font-size: 17px; color: white; background-color: rgba(18,30,39,.65); padding: 3px; -unity-text-align: middle-center; }
#mapScale { position: absolute; left: 12px; top: 102px; height: 23px; border-bottom-width: 2px; border-left-width: 2px; border-right-width: 2px; border-color: white; background-color: rgba(18,30,39,.65); }
#mapScaleText { font-size: 11px; color: white; white-space: nowrap; margin: 0; padding: 0 3px; }

#cursorRange { position: absolute; left: 12px; top: 134px; margin: 0; padding: 2px 4px; font-size: 12px; color: white; background-color: rgba(18,30,39,.65); }
.ship-label-leader { position: absolute; height: 1px; background-color: rgba(220,230,235,.75); transform-origin: 0% 50%; }
